# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=google/gemini-2.5-flash
OPENAI_BASE_URL=https://openrouter.ai/api/v1  # Optional: Custom OpenAI-compatible endpoint

# LangSmith / LangChain Tracing (optional)
# Enable tracing and set your LangSmith credentials to capture LangChain runs
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=drinkup-dev

# Mem0 Configuration
MEMORY_ENABLED=false
MEM0_API_KEY=your_mem0_api_key_here
MEM0_BASE_URL=https://api.mem0.ai

# Mem0 Embedding API Configuration
MEM0_EMBEDDING_API_KEY=your_embedding_api_key_here
MEM0_EMBEDDING_BASE_URL=https://your-openai-compatible-embedding-endpoint/v1
MEM0_EMBEDDING_MODEL=text-embedding-3-large

# Milvus Configuration for Mem0 Vector Store (Primary storage)
# Milvus provides persistent vector storage for memories
MILVUS_URL=http://localhost:19530  # Milvus server URL
MILVUS_TOKEN=  # Optional: Authentication token for Milvus (leave empty for local setup)
MILVUS_COLLECTION_NAME=mem0  # Collection name in Milvus
MILVUS_DB_NAME=  # Optional: Database name (leave empty for default)

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# DrinkUp Backend Configuration
DRINKUP_BACKEND_URL=http://localhost:8080
DRINKUP_BACKEND_TIMEOUT=600.0

# Redis Configuration (for conversation memory)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=drinkup
MYSQL_USER=test
MYSQL_PASSWORD=test
